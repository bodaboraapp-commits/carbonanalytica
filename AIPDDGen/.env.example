# ---------------------------------------------------------------------------
# AI PDD Generator - environment template
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------

# Public base URL (used in emails and absolute links).
# With the built-in dev server: http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000
APP_ENV=development
APP_DEBUG=1

# XAMPP MariaDB (note: this XAMPP installation listens on port 3307).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pdd_generator
DB_USER=root
DB_PASS=

# Email. `log` writes messages to storage/logs/mail.log and the email_outbox
# table, which is all local development needs.
EMAIL_TRANSPORT=log
EMAIL_FROM="AI PDD Generator <no-reply@pddgen.local>"

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console
# and add this authorised redirect URI:
#   ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=